  {
    "commandType": "state.transaction",
    "id": "story.s01.complete",
    "name": "S01 剧情完成（转场 S02）",
    "transaction": {
      "travel": {
        "sceneId": "S02",
        "spawnRef": "player",
        "transition": "fadeBlack"
      },
      "when": {
        "all": [
          {
            "equals": "S01",
            "path": "story.currentSceneId"
          }
        ]
      },
      "writes": [
        {
          "path": "s01Completed",
          "target": "story",
          "value": true
        },
        {
          "path": "s01Survival.cliffReached",
          "target": "story",
          "value": true
        },
        {
          "path": "currentSceneId",
          "target": "story",
          "value": "S02"
        },
        {
          "path": "pendingDefeatResolution",
          "target": "story",
          "value": null
        },
        {
          "path": "specialFaintRescueType",
          "target": "story",
          "value": null
        },
        {
          "path": "unlockedScenes",
          "target": "story",
          "value": {
            "$appendUnique": {
