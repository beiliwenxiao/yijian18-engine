[
  {
    "commandType": "state.transaction",
    "id": "story.s01.specialFaint.prepare",
    "name": "特殊昏迷·救援准备",
    "transaction": {
      "when": {
        "all": [
          {
            "equals": "S01",
            "path": "story.currentSceneId"
          }
        ]
      },
      "writes": [
        {
          "path": "pendingDefeatResolution",
          "target": "story",
          "value": "specialFaint"
        },
        {
          "path": "specialFaintRescueType",
          "target": "story",
          "value": {
            "$get": "payload.rescueType",
            "default": "passerby"
          }
        }
      ]
    }
  },
  {
    "commandType": "state.transaction",
    "id": "story.s01.specialFaint.clear",
    "name": "特殊昏迷·状态清除",
    "transaction": {
      "when": {
        "equals": "specialFaint",
        "path": "story.pendingDefeatResolution"
      },
      "writes": [
        {
          "path": "pendingDefeatResolution",
          "target": "story",
          "value": null
        },
        {
          "path": "specialFaintRescueType",
          "target": "story",
          "value": null
        }
      ]
    }
  },
  {
    "commandType": "state.transaction",
