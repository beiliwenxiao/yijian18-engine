    "commandType": "state.transaction",
    "id": "story.s01.complete",
    "name": "S01 剧情完成（转场 S02）",
    "transaction": {
      "travel": {
        "sceneId": "S02",
        "spawnRef": "player",
        "transition": "fadeBlack"
      },
      "when": {
        "all": [
          {
            "equals": "S01",
            "path": "story.currentSceneId"
          },
          {
            "equals": true,
            "path": "story.s01Survival.cliffReached"
          }
        ]
      },
      "writes": [
        {
          "path": "s01Completed",
          "target": "story",
          "value": true
        },
        {
          "path": "currentSceneId",
          "target": "story",
          "value": "S02"
        },
        {
          "path": "pendingDefeatResolution",
          "target": "story",
          "value": null
        },
        {
          "path": "specialFaintRescueType",
          "target": "story",
          "value": null
        },
        {
          "path": "s01Survival.pursuit.active",
          "target": "story",
          "value": false
        },
        {
          "path": "unlockedScenes",
          "target": "story",
          "value": {
            "$appendUnique": {
              "source": {
                "$get": "story.unlockedScenes",
                "default": []
              },
              "values": [
                "S02"
              ]
            }
          }
        }
      ]
    }
  },
  {
