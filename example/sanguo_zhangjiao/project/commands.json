  {
    "commandType": "state.transaction",
    "id": "story.s09.enlist",
    "name": "加入黄巾军",
    "transaction": {
      "checkpoint": {
        "checkpointId": "checkpoint.S09.enlisted",
        "reason": "checkpoint",
        "sceneId": "S09"
      },
      "when": {
        "all": [
          {
            "equals": "S09",
            "path": "story.currentSceneId"
          },
          {
            "equals": false,
            "path": "story.joinedYellowTurban"
          }
        ]
      },
      "writes": [
