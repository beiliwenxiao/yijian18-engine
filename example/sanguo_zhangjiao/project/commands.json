  {
    "commandType": "state.transaction",
    "id": "story.s01.refuelCampfire",
    "name": "篝火添柴（遇狼前）",
    "transaction": {
      "inventory": {
        "entries": [
          {
            "itemId": "resource.wood",
            "quantity": 1
          }
        ],
        "type": "batchRemove"
      },
      "when": {
        "all": [
          {
            "equals": "S01",
            "path": "story.currentSceneId"
          },
          {
            "equals": true,
            "path": "story.s01Survival.campfireLit"
          },
          {
            "equals": true,
            "path": "story.s01Survival.axeFound"
          },
          {
            "equals": false,
            "path": "story.s01Survival.firstWolfSpotted"
          },
          {
            "lte": 2,
            "path": "story.s01Survival.campfireRefuelCount"
          }
        ]
      },
      "writes": [
        {
          "path": "s01Survival.campfireRefuelCount",
          "target": "story",
          "value": {
            "$add": [
              {
                "$get": "story.s01Survival.campfireRefuelCount"
              },
              1
            ]
          }
        }
      ]
    }
  },
  {
    "commandType": "state.transaction",
