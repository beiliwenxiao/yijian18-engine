        },
        {
          "path": "joinedYellowTurban",
          "target": "blackboard",
          "value": true
        }
      ]
    }
  },
  {
    "commandType": "state.transaction",
    "id": "story.s09.day.advance",
    "name": "推进当前天数",
    "transaction": {
      "writes": [
        {
          "path": "currentDay",
          "target": "story",
          "value": {
            "$get": "payload.day"
          }
        }
      ]
    }
  },
  {
    "commandType": "state.transaction",
    "id": "story.s09.delayed.resolve",
    "name": "延迟后果结算",
    "transaction": {
      "delayed": {
        "currentDayPath": "story.currentDay",
        "path": "delayedConsequences"
      },
      "selector": {
        "$get": "event.type"
      },
      "variants": {
        "s09.hardlineEscape": {
          "outcome": {
            "$if": [
              {
                "$get": "event.payload.willEscape"
              },
              "escapeOccurred",
              "noEscape"
            ]
          },
          "writes": [
            {
              "path": "s09RefugeeConflict",
              "target": "story",
              "value": {
                "$merge": [
                  {
                    "$get": "story.s09RefugeeConflict"
                  },
                  {
                    "hardlineEscapeDay": {
                      "$get": "story.currentDay"
                    },
                    "hardlineEscapeOccurred": {
                      "$get": "event.payload.willEscape"
                    }
                  }
                ]
              }
            }
          ]
        },
        "s09.silenceFoodCollapse": {
          "outcome": "foodCollapsed",
          "writes": [
            {
              "cityId": "city.s09_guangzong_camp",
              "path": "resources.food",
              "target": "city",
              "value": 0
            },
            {
              "path": "hiddenClues",
              "target": "story",
              "value": {
                "$appendUnique": {
                  "source": {
                    "$get": "story.hiddenClues",
                    "default": []
                  },
                  "values": [
                    "s09.refugees.breadArmClue"
                  ]
                }
              }
            }
          ]
        }
      }
    }
  },
  {
    "commandType": "state.transaction",
    "id": "story.s09.refugee.prepare",
    "name": "难民冲突·预备",
    "transaction": {
      "when": {
        "all": [
          {
            "equals": "S09",
            "path": "story.currentSceneId"
          },
          {
            "gte": 0.4,
            "path": "cityStates.0.damageRatio"
          },
          {
            "gte": 0.000001,
            "path": "cityStates.0.buildingDamage.granary.s09"
          }
        ]
      },
      "writes": [
        {
          "path": "s09RefugeeConflict",
          "target": "story",
          "value": {
            "$if": [
              {
                "$get": "story.s09RefugeeConflict"
              },
              {
                "$get": "story.s09RefugeeConflict"
              },
              {
                "branch": null,
                "donationCommitted": false,
                "presentationActive": true,
                "result": null,
                "status": "available",
                "triggeredDay": {
                  "$get": "story.currentDay",
                  "default": 1
                }
              }
            ]
          }
        }
      ]
    }
  },
  {
    "commandType": "state.transaction",
    "id": "story.s09.refugee.start",
    "name": "难民冲突·开始",
    "transaction": {
      "when": {
        "all": [
          {
            "equals": "S09",
            "path": "story.currentSceneId"
          },
          {
            "equals": "available",
            "path": "story.s09RefugeeConflict.status"
          }
        ]
      },
      "writes": [
        {
          "path": "s09RefugeeConflict.status",
          "target": "story",
          "value": "started"
        }
      ]
    }
  },
  {
    "commandType": "state.transaction",
    "id": "story.s09.refugee.donate",
    "name": "捐赠粮草安抚难民",
    "transaction": {
      "checkpoint": {
        "checkpointId": "checkpoint.S09.refugeeDonation",
        "reason": "checkpoint",
        "sceneId": "S09"
      },
      "inventory": {
        "entries": [
          {
            "itemId": "resource.food",
            "quantity": 20
          }
        ],
        "type": "batchRemove"
      },
      "when": {
        "all": [
          {
            "equals": "S09",
            "path": "story.currentSceneId"
          },
          {
            "equals": false,
            "path": "story.s09RefugeeConflict.donationCommitted"
          },
          {
            "inventory": {
              "itemId": "resource.food",
              "quantity": 20
            }
          }
        ]
      },
      "writes": [
        {
          "cityId": "city.s09_guangzong_camp",
          "path": "morale",
          "target": "city",
          "value": {
            "$min": [
              100,
              {
                "$add": [
                  {
                    "$get": "cityStates.0.morale"
                  },
                  5
                ]
              }
            ]
          }
        },
        {
          "cityId": "city.s09_guangzong_camp",
          "path": "damagePausedUntilDay",
          "target": "city",
          "value": {
            "$add": [
              {
                "$get": "story.currentDay",
                "default": 1
              },
              1
            ]
          }
        },
        {
          "path": "s09RefugeeConflict",
          "target": "story",
          "value": {
            "$merge": [
              {
                "$get": "story.s09RefugeeConflict"
              },
              {
                "donationCommitted": true,
                "donationDay": {
                  "$get": "story.currentDay",
                  "default": 1
                },
                "donationOperationId": {
                  "$get": "payload.operationId",
                  "default": "donation"
                },
                "status": "donated"
              }
            ]
          }
        }
      ]
    }
  },
  {
    "commandType": "state.transaction",
    "id": "story.s09.refugee.branch",
    "name": "难民冲突·分支抉择",
    "transaction": {
      "selector": {
        "$get": "payload.event.choiceId"
      },
      "variantDefinitions": {
        "donate_food": "story.s09.refugee.donate",
        "retry_donation": "story.s09.refugee.donate"
      },
      "variants": {
        "appease": {
          "checkpoint": {
            "checkpointId": "checkpoint.S09.refugeeBranch.appease",
            "reason": "checkpoint",
            "sceneId": "S09"
          },
          "onPreconditionFailed": {
            "checkpoint": {
              "checkpointId": "checkpoint.S09.refugeeBranch.appeaseScout",
              "reason": "checkpoint",
              "sceneId": "S09"
            },
            "writes": [
              {
                "path": "storyTags",
                "target": "story",
                "value": {
                  "$appendUnique": {
                    "source": {
                      "$get": "story.storyTags",
                      "default": []
                    },
                    "values": [
                      "s09.refugees.appeaseScout"
                    ]
                  }
                }
              },
              {
                "path": "s09RefugeeConflict",
                "target": "story",
                "value": {
                  "$merge": [
                    {
                      "$get": "story.s09RefugeeConflict"
                    },
                    {
                      "branch": "appease",
                      "result": "scoutTriggered",
                      "scoutTriggered": true,
                      "status": "resolved"
                    }
                  ]
                }
              }
            ]
          },
          "when": {
            "inventory": {
              "toolType": "axe"
            }
          },
          "writes": [
            {
              "path": "storyTags",
              "target": "story",
              "value": {
                "$appendUnique": {
                  "source": {
                    "$get": "story.storyTags",
                    "default": []
                  },
                  "values": [
                    "s09.refugees.appeasedWithGathering"
                  ]
                }
              }
            },
            {
              "path": "s09RefugeeConflict",
              "target": "story",
              "value": {
                "$merge": [
                  {
                    "$get": "story.s09RefugeeConflict"
                  },
                  {
                    "branch": "appease",
                    "result": "foodRestored",
                    "status": "resolved"
                  }
                ]
              }
            }
          ]
        },
        "hardline": {
          "checkpoint": {
            "checkpointId": "checkpoint.S09.refugeeBranch.hardline",
            "reason": "checkpoint",
            "sceneId": "S09"
          },
          "writes": [
            {
              "cityId": "city.s09_guangzong_camp",
              "path": "morale",
              "target": "city",
              "value": {
                "$min": [
                  100,
                  {
                    "$add": [
                      {
                        "$get": "cityStates.0.morale"
                      },
                      10
                    ]
                  }
                ]
              }
            },
            {
              "path": "storyTags",
              "target": "story",
              "value": {
                "$appendUnique": {
                  "source": {
                    "$get": "story.storyTags",
                    "default": []
                  },
                  "values": [
                    "s09.refugees.hardline",
                    "s09.refugees.strictCommander"
                  ]
                }
              }
            },
            {
              "path": "s09RefugeeConflict",
              "target": "story",
              "value": {
                "$merge": [
                  {
                    "$get": "story.s09RefugeeConflict"
                  },
                  {
                    "branch": "hardline",
                    "hardlineEscapeOccurred": {
                      "$chance": 0.35
                    },
                    "result": "hardlineEscapeScheduled",
                    "status": "resolved"
                  }
                ]
              }
            },
            {
              "path": "delayedConsequences",
              "target": "story",
              "value": {
                "$concat": [
                  {
                    "$get": "story.delayedConsequences",
                    "default": []
                  },
                  [
                    {
                      "dueDay": {
                        "$add": [
                          {
                            "$get": "story.currentDay",
                            "default": 1
                          },
                          1
                        ]
                      },
                      "id": "story:S09:hardline-escape",
                      "payload": {
                        "willEscape": {
                          "$get": "story.s09RefugeeConflict.hardlineEscapeOccurred"
                        }
                      },
                      "status": "pending",
                      "type": "s09.hardlineEscape"
                    }
                  ]
                ]
              }
            }
          ]
        },
        "silence": {
          "checkpoint": {
            "checkpointId": "checkpoint.S09.refugeeBranch.silence",
            "reason": "checkpoint",
            "sceneId": "S09"
          },
          "writes": [
            {
              "path": "storyTags",
              "target": "story",
              "value": {
                "$appendUnique": {
                  "source": {
                    "$get": "story.storyTags",
                    "default": []
                  },
                  "values": [
                    "s09.refugees.silence"
                  ]
                }
              }
            },
            {
              "path": "s09RefugeeConflict",
              "target": "story",
              "value": {
                "$merge": [
                  {
                    "$get": "story.s09RefugeeConflict"
                  },
                  {
                    "branch": "silence",
                    "result": "delayedFoodCollapse",
                    "status": "resolved"
                  }
                ]
              }
            },
            {
              "path": "delayedConsequences",
              "target": "story",
              "value": {
                "$concat": [
                  {
                    "$get": "story.delayedConsequences",
                    "default": []
                  },
                  [
                    {
                      "dueDay": {
                        "$add": [
                          {
                            "$get": "story.currentDay",
                            "default": 1
                          },
                          1
                        ]
                      },
                      "id": "story:S09:silence-food-collapse",
                      "status": "pending",
                      "type": "s09.silenceFoodCollapse"
                    }
                  ]
                ]
              }
            }
          ]
        }
      },
      "when": {
        "all": [
          {
            "equals": "S09",
            "path": "story.currentSceneId"
          },
          {
            "equals": true,
            "path": "story.s09RefugeeConflict.donationCommitted"
          }
        ]
      }
    }
  }
]
