    "cartBreakout": { "condition": { "all": [{ "path": "resourceState.cart.available", "op": "eq", "value": true }, { "path": "resourceState.cart.destroyed", "op": "eq", "value": false }, { "path": "resourceState.food", "op": "gte", "value": 20 }, { "path": "resourceState.herb", "op": "gte", "value": 8 }] }, "resultId": "cart-breakout", "subtitle": "把最后的粮和伤员装上马车，从密道外沿山路突围。", "cameraId": "s14.cart.mountain-breakout", "musicId": "music.ending.retreat" },
    "cartLost": { "resultId": "cart-lost", "subtitle": "马车已毁，货物散落后货舱清空；这次损失不会再次生成资源。", "cameraId": "s14.cart.wreckage", "musicId": "music.ending.loss" },
    "catapultReady": { "condition": { "path": "resourceState.wood", "op": "gte", "value": 40 }, "resultId": "catapult-ready", "subtitle": "最后一根主梁装上车架，投石车赶在决战前完成组装。", "cameraId": "s14.catapult.assembled", "musicId": "music.ending.siege-ready" },
    "catapultMissingWood": { "resultId": "catapult-missing-wood", "subtitle": "投石车只差最后一根主梁，但仓里已经没有木头。它不会在这场战斗中开火。", "cameraId": "s14.catapult.missing-beam", "musicId": "music.ending.silence" }
