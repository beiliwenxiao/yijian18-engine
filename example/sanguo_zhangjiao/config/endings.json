    { "id": "class", "path": "storyState.classId", "text": "你选择了「{value|className}」。" }, { "id": "refugees", "path": "storyState.s09RefugeeConflict.choiceId", "text": "饥民争斗：{value|refugeeChoice}。" },
    { "id": "yingchuan", "path": "battleModeStats.yingchuan", "text": "颍川：{value|battleMode}。" }, { "id": "bocai", "path": "heroes.bocai.survived", "text": "波才：{value|survival}。" },
    { "id": "route", "path": "storyState.yuzhouRoute.routeId", "text": "路线：{value|routeName}。" }, { "id": "zhang-mancheng", "path": "heroes.zhangMancheng.status", "text": "张曼成：{value|heroStatus}。" },
    { "id": "zhang-liang", "path": "heroes.zhangLiang.survived", "text": "张梁：{value|survival}。" }, { "id": "zhang-bao", "path": "heroes.zhangBao.survived", "text": "张宝：{value|survival}。" },
    { "id": "gathering", "path": "hiddenInputs.cumulativeGathering", "text": "累计采集：木 {value.wood}、铁 {value.iron}、粮 {value.food}、药 {value.herb}。" },
    { "id": "city-damage", "path": "cityState.coreDamageRatio", "text": "城市最终损毁：{value|percent}。" }, { "id": "ending", "path": "ending.title", "text": "结局：{value}。" }
  ],
  "endings": [
    { "id": "chaos-weed", "title": "乱世草芥——山道旁的无名尸骸", "hidden": true, "condition": { "all": [{ "path": "storyState.s02ZhangjiaoChoice", "op": "eq", "value": "kill" }] }, "keyArtImageId": "ending.art.dust", "musicId": "music.ending.dust", "shots": [{ "cameraId": "ending.chaos.roadside", "durationMs": 5600, "subtitle": "士兵取走了你的药囊，头也不回地回了营地。" }, { "cameraId": "ending.chaos.camp", "durationMs": 5400, "subtitle": "营地的火光在身后渐远，山道上的身影被夜风吹散。" }, { "cameraId": "ending.chaos.weed", "durationMs": 5400, "subtitle": "乱世里，人命如草芥。没有史书会记下这一晚。" }] },
    { "id": "scorched-earth", "title": "焦土——没有家当，也没有归路", "hidden": true, "condition": { "all": [{ "path": "storyState.scorchedEarthChoice", "op": "eq", "value": true }, { "path": "cityState.coreDamageRatio", "op": "gte", "value": 0.8 }, { "path": "hiddenInputs.resourceConstructionScore", "op": "gte", "value": 3 }] }, "keyArtImageId": "ending.art.scorchedEarth", "musicId": "music.ending.scorched-earth", "shots": [{ "cameraId": "ending.scorched.granary", "durationMs": 4800, "subtitle": "你亲手点燃最后一座粮仓。" }, { "cameraId": "ending.scorched.empty-city", "durationMs": 5600, "subtitle": "官军得到的只有空城、灰烬和来不及埋葬的名字。" }, { "cameraId": "ending.scorched.road", "durationMs": 5200, "subtitle": "后人说那是一场败退。只有你知道，那是一次由自己选择的清零。" }], "unlockId": "ending.scorched-earth" },
    { "id": "observer", "title": "旁观者——活着看完一切", "condition": { "all": [{ "path": "battleModeStats.allOptionalBattlesObserved", "op": "eq", "value": true }, { "path": "battleModeStats.interventionCount", "op": "eq", "value": 0 }] }, "keyArtImageId": "ending.art.observer", "musicId": "music.ending.observer", "shots": [{ "cameraId": "ending.observer.battlefields", "durationMs": 6000, "subtitle": "你看过颍川的尘、长社的火、广宗的烽烟，却从未走进任何一条战线。" }, { "cameraId": "ending.observer.cloak", "durationMs": 5200, "subtitle": "史书没有你的名字。你活到了最后。" }, { "cameraId": "ending.observer.departure", "durationMs": 4500, "subtitle": "箱底多出一件旧斗篷——不是奖赏，只是一个过客留下的证明。" }], "unlockId": "item.wanderer_cloak" },
    { "id": "spark", "title": "火种——山中二十年", "condition": { "all": [{ "path": "heroes.zhangLiang.survived", "op": "eq", "value": true }, { "path": "heroes.zhangBao.survived", "op": "eq", "value": true }, { "path": "retreatReadiness.ready", "op": "eq", "value": true }] }, "keyArtImageId": "ending.art.spark", "musicId": "music.ending.spark", "shots": [{ "cameraId": "ending.spark.taihang", "durationMs": 5600, "subtitle": "张梁与张宝带残部退入太行山。" }, { "cameraId": "ending.spark.twenty-years", "durationMs": 6200, "subtitle": "黄巾的旗在山里多留了二十年。" }, { "cameraId": "ending.spark.commander", "durationMs": 4800, "subtitle": "新一代士卒不再叫你流民。他们叫你统帅。" }] },
    { "id": "ember", "title": "余烬——只剩一面旗", "condition": { "any": [{ "all": [{ "path": "heroes.zhangLiang.survived", "op": "eq", "value": true }, { "path": "heroes.zhangBao.survived", "op": "eq", "value": false }] }, { "all": [{ "path": "heroes.zhangLiang.survived", "op": "eq", "value": false }, { "path": "heroes.zhangBao.survived", "op": "eq", "value": true }] }, { "all": [{ "path": "heroes.zhangLiang.survived", "op": "eq", "value": true }, { "path": "heroes.zhangBao.survived", "op": "eq", "value": true }, { "path": "retreatReadiness.ready", "op": "eq", "value": false }] }] }, "keyArtImageId": "ending.art.embers", "musicId": "music.ending.embers", "shots": [{ "cameraId": "ending.embers.one-banner", "durationMs": 5600, "subtitle": "剩下的首领带着残部继续抵抗。" }, { "cameraId": "ending.embers.forgotten-pass", "durationMs": 5600, "subtitle": "有人后来受了招安，有人死在无人记得的山口。" }, { "cameraId": "ending.embers.lieutenant", "durationMs": 4800, "subtitle": "你站在他身后，像一块没有熄灭、也再烧不旺的炭。" }] },
    { "id": "meteor", "title": "流星——短暂照亮乱世", "condition": { "all": [{ "path": "heroes.zhangLiang.survived", "op": "eq", "value": false }, { "path": "heroes.zhangBao.survived", "op": "eq", "value": false }, { "any": [{ "path": "heroes.bocai.survived", "op": "eq", "value": true }, { "path": "heroes.zhangMancheng.survived", "op": "eq", "value": true }] }] }, "keyArtImageId": "ending.art.meteor", "musicId": "music.ending.meteor", "shots": [{ "cameraId": "ending.meteor.local-rule", "durationMs": 5400, "subtitle": "活下来的旧将占住一块地方，像夜里突然亮起的星。" }, { "cameraId": "ending.meteor.falling", "durationMs": 5600, "subtitle": "那道光很快，后来被曹操的版图吞没。" }, { "cameraId": "ending.meteor.harvest", "durationMs": 4700, "subtitle": "但在它落下以前，仍有人因为那点光多活了一季。" }] },
    { "id": "dust", "title": "尘埃——史书无名", "fallback": true, "condition": true, "keyArtImageId": "ending.art.dust", "musicId": "music.ending.dust", "shots": [{ "cameraId": "ending.dust.history", "durationMs": 5200, "subtitle": "黄巾覆灭。史书用寥寥几字写完这一年。" }, { "cameraId": "ending.dust.empty-camp", "durationMs": 5200, "subtitle": "你的名字不在其中。" }, { "cameraId": "ending.dust.wind", "durationMs": 5600, "subtitle": "风吹过曾经的营地，卷走最后一点灰。" }] }
  ],
  "formatMaps": { "className": { "warrior": "战士", "archer": "弓手", "strategist": "军师" }, "refugeeChoice": { "hardline": "强硬", "appease": "安抚", "silence": "沉默" }, "battleMode": { "observe": "观战", "intervene": "介入" }, "survival": { "true": "存活", "false": "死亡" }, "routeName": { "nanyang": "南阳", "xihua": "西华" }, "heroStatus": { "alive": "存活", "dead": "死亡", "notVisited": "未前往" } }
